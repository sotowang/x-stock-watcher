[Unit]
Description=X Stock Watcher Discord Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xstockwatcher
Group=xstockwatcher
WorkingDirectory=/opt/x-stock-watcher/server
EnvironmentFile=/etc/x-stock-watcher-relay.env
ExecStart=/opt/x-stock-watcher/server/relay
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/x-stock-watcher

[Install]
WantedBy=multi-user.target

